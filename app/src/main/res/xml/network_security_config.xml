<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV playlists and streams frequently live on plain HTTP hosts.
     Cleartext is permitted so user-supplied sources resolve. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>